{
  "manifest_version": 2,
  "name": "Command Nova — новая вкладка",
  "short_name": "Command Nova",
  "description": "Command Nova — рабочая новая вкладка: поиск Google, часы, статус-панель и компактная редактируемая сетка сайтов.",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "command-nova@local",
      "strict_min_version": "115.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
